# Kopieren nach .env und ALLE Werte ändern. .env niemals auf GitHub hochladen!
DB_PASSWORD=BITTE_AENDERN
# Geheimer Schlüssel für Anmelde-Token, erzeugen mit: openssl rand -hex 32
JWT_SECRET=BITTE_AENDERN_MINDESTENS_32_ZEICHEN
# Erster Admin (wird beim ersten Start angelegt, Passwort mindestens 8 Zeichen)
ADMIN_EMAIL=admin@ihre-firma.de
ADMIN_PASSWORD=BITTE_AENDERN
# Erlaubte Web-Adressen der App. In Produktion z.B. https://app.ihre-firma.de, zum Testen *
CORS_ORIGINS=*
# Adresssuche (OpenStreetMap/Nominatim). Der öffentliche Server ist nur zum Testen gedacht
# (max. 1 Anfrage/Sekunde, Kontakt im User-Agent Pflicht). Für den Echtbetrieb: eigener Nominatim-Server
# oder kommerzieller Anbieter (Nominatim-kompatible Adresse eintragen).
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=FahrdienstApp/1.0 (Kontakt: admin@ihre-firma.de)
GEOCODER_COUNTRY=de
